venv/
__pycache__/
*.pyc
.env
node_modules/
dist/
build/
.idea/
*.log

# Generated by frontend/dashboard/build_dashboard.py + splice_dashboard.py --
# regenerate from the live DB rather than committing a stale data snapshot.
frontend/dashboard/dashboard_data.json
frontend/dashboard/dashboard_final.html

# Local cache of MLB headshot images (see headshots.py) -- binary blobs, not
# source; regenerates itself from MLB's own CDN on first use.
frontend/dashboard/headshots_cache/

# Local SQLite dev database and pipeline scratch (see README.local.md)
backend/mlb_market_value.db
backend/.cache/

# Runtime logs from scripts/nightly_refresh.ps1
scripts/logs/

# Generated by backend/scripts/backtest_projections.py -- regenerate from the
# live DB rather than committing a snapshot that goes stale as more seasons arrive.
backend/backtest_results.csv

# Local cache of MLB team logo SVGs (see logos.py) -- binary blobs, not
# source; regenerates itself from MLB's own CDN on first use.
frontend/dashboard/logos_cache/

# Kilo tooling session state (agent-manager plans, worktrees)
.kilo/plans/
.kilo/worktrees/
